{
  "expo": {
    "name": "FasalDoc",
    "slug": "fasaldoc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1D9E75"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fasaldoc.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D9E75"
      },
      "package": "com.fasaldoc.app"
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "FasalDoc needs access to your photos to analyse leaf images.",
          "cameraPermission": "FasalDoc needs camera access to scan plant leaves."
        }
      ]
    ]
  }
}
